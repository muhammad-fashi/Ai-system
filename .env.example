# =========================================================================
# AI Outbound Calling System — Environment Configuration
# Copy this file to `.env` (local) or set these in the Vercel dashboard.
# NEVER commit real secrets. NEVER expose RETELL_API_KEY to the browser.
# =========================================================================

# --- Database (PostgreSQL) -----------------------------------------------
# Vercel Postgres / Neon / Supabase / any Postgres connection string.
# For Vercel Postgres use the pooled (PgBouncer) URL for DATABASE_URL and
# the direct URL for DIRECT_URL (used by prisma migrate).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Application ---------------------------------------------------------
# Public base URL of the deployed app (used to build the Retell webhook URL).
APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# --- Authentication ------------------------------------------------------
# Long random string used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Retell AI (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_) -------
RETELL_API_KEY=""
RETELL_AGENT_ID=""
RETELL_PHONE_NUMBER="+15551234567"
RETELL_FROM_NUMBER="+15551234567"

# Secret used to verify inbound Retell webhooks. Set this to the signing
# secret Retell provides for your webhook, or your own shared secret.
RETELL_WEBHOOK_SECRET=""

# --- Cron / Queue security ----------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when
# CRON_SECRET is set in the project. The queue processor rejects calls
# without it in production.
CRON_SECRET="change-me-to-a-long-random-string"

# --- Optional: Redis (Upstash) for distributed locks / rate limiting -----
# Not required. The default queue is database-backed and works on Vercel.
REDIS_URL=""

# --- Runtime mode --------------------------------------------------------
# When RETELL_API_KEY is empty the system runs in MOCK mode (safe dev):
# it simulates calls/transcripts instead of hitting Retell. In production,
# set RETELL_API_KEY and the system will place real calls.
